.env
.env.bak

# Python artifacts
__pycache__/
*.py[cod]
*$py.class

# IDEs & editors
.idea/
.vscode/

# Certificates generated by tests/setup.py / setup/certificate_auth.py
tests/selfsigncert.crt
tests/selfsigncert.pem

# Docs build output (mkdocs)
/site/

# Generator run checkpoints
generator/.checkpoints/

# Generator run manifest (last synced metadata snapshot)
generator/.state/

# Generator documentation cache (regenerated from graphopenapi.yaml)
generator/documentation/graphopenapi.cache.json

# Example run checkpoints (data-pipeline resume state)
*.checkpoint.json
.migration/

# local virtualenvs
.repro-venv/

# Coverage database (per-run artifact, not a source file)
.coverage

# JetBrains AI assistant plans/session state (local tooling, not project source)
.junie/
